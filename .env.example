RAILS_ENV=development
APP_HOST=localhost

# Required when RAILS_ENV=production; development falls back to
# tmp/local_secret.txt. Generate one with `bin/rails secret`.
# SECRET_KEY_BASE=

# Optional. Defaults are below; uncomment only to override.
# DB_HOST=localhost
# PG_USER=postgres
# PG_PASSWORD=
# RAILS_MAX_THREADS=5
# RAILS_LOG_LEVEL=info
# JOB_CONCURRENCY=1
# WEB_CONCURRENCY=1
# PORT=3000
# PIDFILE=tmp/pids/server.pid
# SOLID_QUEUE_IN_PUMA=
# CI=
